{
  "manifest_version": 3,
  "name": "电商图片提取下载",
  "version": "1.0.0",
  "description": "在淘宝/天猫、京东、拼多多商家版商品详情页一键提取全部图片，勾选后批量下载为 PNG。所有处理均在本地完成，不上传任何数据。",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "*://item.taobao.com/*",
    "*://detail.tmall.com/*",
    "*://item.jd.com/*",
    "*://mobile.yangkeduo.com/*",
    "*://*.alicdn.com/*",
    "*://*.360buyimg.com/*",
    "*://*.pddpic.com/*",
    "*://desc.alicdn.com/*",
    "*://dsc.taobaocdn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://item.taobao.com/*",
        "*://detail.tmall.com/*",
        "*://item.jd.com/*",
        "*://mobile.yangkeduo.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}